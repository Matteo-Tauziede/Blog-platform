<% const title = 'New Post' %>
<%- include('partials/header', { title, currentUser }) %>

<h1>New Post</h1>

<% if (error) { %><p class="alert alert-error"><%= error %></p><% } %>

<form action="/posts" method="POST" class="post-form">
  <label for="post-title">Title</label>
  <input type="text" id="post-title" name="title" value="<%= formData.title || '' %>" required placeholder="Give your post a title" />

  <label for="tags">Tags <span class="hint">(comma-separated)</span></label>
  <input type="text" id="tags" name="tags" value="<%= formData.tags || '' %>" placeholder="e.g. javascript, node, tutorial" />

  <div class="editor-tabs">
    <button type="button" id="tab-write" class="tab-btn tab-active">Write</button>
    <button type="button" id="tab-preview" class="tab-btn">Preview</button>
  </div>

  <div class="editor-panes">
    <div id="write-pane" class="pane">
      <label for="content">Content <span class="hint">(Markdown supported)</span></label>
      <textarea id="content" name="content" rows="16" required placeholder="Write your post in Markdown..."><%= formData.content || '' %></textarea>
    </div>
    <div id="preview-pane" class="pane hidden">
      <label>Preview</label>
      <div id="markdown-preview" class="markdown-preview"></div>
    </div>
  </div>

  <label class="checkbox-label">
    <input type="checkbox" name="isPublic" <%= (formData.isPublic === undefined || formData.isPublic) ? 'checked' : '' %> />
    Make this post public (visible to everyone)
  </label>

  <div class="form-actions">
    <button type="submit" class="btn btn-primary">Publish Post</button>
    <a href="/" class="btn btn-secondary">Cancel</a>
  </div>
</form>

<script src="https://cdnjs.cloudflare.com/ajax/libs/marked/12.0.2/marked.min.js"></script>
<script src="/js/editor.js"></script>

<%- include('partials/footer') %>
