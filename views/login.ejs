<% const title = 'Log In' %>
<%- include('partials/header', { title, currentUser }) %>

<div class="auth-form-wrap">
  <h1>Log In</h1>
  <% if (error) { %><p class="alert alert-error"><%= error %></p><% } %>

  <form action="/login" method="POST" class="auth-form">
    <label for="username">Username</label>
    <input type="text" id="username" name="username" value="<%= formData.username || '' %>" required autofocus />

    <label for="password">Password</label>
    <input type="password" id="password" name="password" required />

    <button type="submit" class="btn btn-primary btn-block">Log In</button>
  </form>

  <p class="auth-switch">Don't have an account? <a href="/register">Sign up</a></p>
</div>

<%- include('partials/footer') %>
